if(NOT DEFINED ASSET_ROOT)
    message(FATAL_ERROR "ASSET_ROOT is required")
endif()
file(READ "${ASSET_ROOT}/assets.lock.json" lock)
string(JSON count LENGTH "${lock}" packages)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${lock}" packages ${index} name)
    string(JSON expected GET "${lock}" packages ${index} manifest_sha256)
    set(root "${ASSET_ROOT}/${name}")
    file(SHA256 "${root}/source-manifest.json" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Asset manifest changed: ${name}")
    endif()
    file(READ "${root}/source-manifest.json" manifest)
    string(JSON license GET "${manifest}" license)
    if(NOT license STREQUAL "CC0-1.0")
        message(FATAL_ERROR "Non-CC0 asset: ${name}")
    endif()
    file(READ "${root}/License.txt" original_license)
    if(NOT original_license MATCHES "CC0")
        message(FATAL_ERROR "Original CC0 license missing: ${name}")
    endif()
    string(JSON files LENGTH "${manifest}" files)
    math(EXPR last_file "${files} - 1")
    foreach(file_index RANGE 0 ${last_file})
        string(JSON path GET "${manifest}" files ${file_index} path)
        string(JSON expected GET "${manifest}" files ${file_index} sha256)
        if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Unsafe asset path: ${path}")
        endif()
        file(SHA256 "${root}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Asset content changed: ${name}/${path}")
        endif()
    endforeach()
endforeach()
message(STATUS "CC0 licenses and locked asset bytes verified")
