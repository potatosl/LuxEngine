#include "LuxSceneResources.h"

STRUCT(MeshOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float4, color, COLOR);
    DATA(float2, uv, TEXCOORD0);
    DATA(float3, world, TEXCOORD1);
    DATA(float3, normal, TEXCOORD2);
    DATA(float4, options, TEXCOORD3);
};

#include "LuxBrdf.h"

// Port of Shaders/Modern.frag.hlsl (Basic.frag.hlsl with lit = true and MODERN_3D): writes linear
// HDR colour; LuxTone.frag.fsl applies exposure, tone mapping and sRGB encoding.
ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(MeshOutput In, SV_ISFRONTFACE(bool) frontFacing)
{
    INIT_MAIN;
    float4 texel = SampleMaterial(gTexture, In.uv);
    float4 color = In.color * texel;
    if (gDraw.options.y > 0.5f && gDraw.options.y < 1.5f && color.a < gDraw.options.z)
        discard;
    if (gDraw.options.y < 1.5f)
        color.a = 1.0f;
    const bool authoredNormal = dot(In.normal, In.normal) > 1e-10f;
    const float3 faceNormal = authoredNormal ? In.normal : cross(ddy(In.world), ddx(In.world));
    const float lenSq = dot(faceNormal, faceNormal);
    float3 normal = lenSq > 1e-10f ? faceNormal * rsqrt(lenSq) : float3(0.0f, 1.0f, 0.0f);
    const uint maps = uint(round(gDraw.options.w));
    if ((maps & 1u) != 0u)
    {
        const float2 uvx = ddx(In.uv), uvy = ddy(In.uv);
        const float3 worldx = ddx(In.world), worldy = ddy(In.world);
        const float determinant = uvx.x * uvy.y - uvx.y * uvy.x;
        if (abs(determinant) > 1e-8f)
        {
            float3 tangent = (worldx * uvy.y - worldy * uvx.y) / determinant;
            tangent -= normal * dot(normal, tangent);
            const float tangentLength = dot(tangent, tangent);
            if (tangentLength > 1e-10f)
            {
                tangent *= rsqrt(tangentLength);
                const float3 rawBitangent = (worldy * uvx.x - worldx * uvy.x) / determinant;
                const float3 bitangent = cross(normal, tangent) * (dot(cross(normal, tangent), rawBitangent) < 0.0f ? -1.0f : 1.0f);
                float3 mapped = SampleMaterial(gNormalTexture, In.uv).xyz * 2.0f - 1.0f;
                mapped.xy *= gDraw.materialOptions.x;
                normal = SafeDirection(tangent * mapped.x + bitangent * mapped.y + normal * mapped.z, normal);
            }
        }
    }
    // Derivative fallback normals already face the viewer. Authored/normal-mapped normals
    // retain the mesh's outward orientation and must be reversed for a double-sided back face.
    if (authoredNormal && gDraw.materialOptions.w > 0.5f && !frontFacing)
        normal = -normal;
    const uint pointCount = min(gLights.count.x, 16u);
    if (In.options.w > 0.5f)
    {
        const float3 v = SafeDirection(gLights.camera.xyz - In.world, normal);
        const float metal = saturate(In.options.y * ((maps & 2u) != 0u ? SampleMaterial(gMetallicTexture, In.uv).r : 1.0f));
        const float rough = clamp(In.options.z * ((maps & 4u) != 0u ? SampleMaterial(gRoughnessTexture, In.uv).r : 1.0f), 0.045f, 1.0f);
        float3 result = Brdf(color.rgb, metal, rough, normal, v, -gLights.direction.xyz) *
                        gLights.colorIntensity.rgb * max(gLights.colorIntensity.w, 0.0f);
        result *= DirectionalShadow(In.world, normal);
        for (uint i = 0; i < pointCount; ++i)
        {
            const float4 source = gLights.pointPositionRadius[i];
            const float4 sourceColor = gLights.pointColorIntensity[i];
            const float3 delta = source.xyz - In.world;
            const float distance = length(delta);
            const float falloff = saturate(1.0f - distance / max(source.w, 1e-5f));
            result += Brdf(color.rgb, metal, rough, normal, v, SafeDirection(delta, normal)) * sourceColor.rgb *
                      max(sourceColor.w, 0.0f) * falloff * falloff;
        }
        const float occlusion = (maps & 8u) != 0u ? lerp(1.0f, SampleMaterial(gOcclusionTexture, In.uv).r, gDraw.materialOptions.y) : 1.0f;
        result += EnvironmentLighting(color.rgb, metal, rough, normal, v) * occlusion;
        color.rgb = result;
    }
    else
    {
        float3 light = gLights.colorIntensity.rgb *
                       (max(0.0f, dot(normal, -gLights.direction.xyz)) * max(0.0f, gLights.colorIntensity.w));
        for (uint i = 0; i < pointCount; ++i)
        {
            const float4 source = gLights.pointPositionRadius[i];
            const float4 sourceColor = gLights.pointColorIntensity[i];
            const float3 toLight = source.xyz - In.world;
            const float distance = length(toLight);
            if (source.w <= 0.0f || distance >= source.w)
                continue;
            const float facing = distance > 0.00001f ? max(0.0f, dot(normal, toLight / distance)) : 1.0f;
            const float falloff = 1.0f - distance / source.w;
            light += sourceColor.rgb * (facing * falloff * falloff * max(0.0f, sourceColor.w));
        }
        color.rgb *= 0.15f + light;
    }
    color.rgb = clamp(color.rgb, 0.0f, 65504.0f);
    RETURN(color);
}
