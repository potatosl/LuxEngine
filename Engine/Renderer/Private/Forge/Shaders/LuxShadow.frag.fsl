#include "LuxSceneResources.h"

STRUCT(ShadowOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float4, color, COLOR);
    DATA(float2, uv, TEXCOORD0);
};

// Port of Shaders/Shadow.frag.hlsl: fully transparent texels cast no shadow.
ROOT_SIGNATURE(DefaultRootSignature)
void PS_MAIN(ShadowOutput In)
{
    INIT_MAIN;
    if (In.color.a * SampleTex2D(gTexture, gSamplerBilinearClamp, In.uv).a == 0.0f)
        discard;
    RETURN();
}
