#include "LuxSceneResources.h"

STRUCT(ShadowOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float4, color, COLOR);
    DATA(float2, uv, TEXCOORD0);
};

// Port of Shaders/Shadow.frag.hlsl: fully transparent texels cast no shadow.
ROOT_SIGNATURE(DefaultRootSignature)
void PS_MAIN(ShadowOutput In)
{
    INIT_MAIN;
    if (gDraw.options.y > 0.5f &&
        In.color.a * SampleMaterial(gTexture, In.uv).a < gDraw.options.z)
        discard;
    RETURN();
}
