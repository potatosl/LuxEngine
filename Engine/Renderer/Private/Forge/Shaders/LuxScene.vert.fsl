#include "LuxSceneResources.h"

STRUCT(VSInput)
{
    DATA(float3, position, POSITION);
    DATA(float4, color, COLOR);
    DATA(float2, uv, TEXCOORD0);
    DATA(float3, normal, NORMAL);
};

STRUCT(MeshOutput)
{
    DATA(float4, position, SV_Position);
    DATA(float4, color, COLOR);
    DATA(float2, uv, TEXCOORD0);
    DATA(float3, world, TEXCOORD1);
    DATA(float3, normal, TEXCOORD2);
    DATA(float4, options, TEXCOORD3);
};

// HDR scene meshes: same as LuxMesh.vert.fsl (port of Shaders/Basic.vert.hlsl).
ROOT_SIGNATURE(DefaultRootSignature)
MeshOutput VS_MAIN(VSInput In)
{
    INIT_MAIN;
    MeshOutput Out;
    const float4 world = mul(gDraw.model, float4(In.position, 1.0f));
    Out.position = mul(gDraw.viewProjection, world);
    Out.color = In.color * gDraw.albedo;
    Out.uv = In.uv;
    Out.world = world.xyz;
    Out.options = gDraw.colorOptions;
    const float3x3 m = float3x3(gDraw.model[0].xyz, gDraw.model[1].xyz, gDraw.model[2].xyz);
    const float3x3 cofactors = float3x3(cross(m[1], m[2]), cross(m[2], m[0]), cross(m[0], m[1]));
    const float determinant = dot(m[0], cofactors[0]);
    Out.normal = abs(determinant) > 1e-10f ? mul(cofactors, In.normal) / determinant : float3(0, 0, 0);
    RETURN(Out);
}
