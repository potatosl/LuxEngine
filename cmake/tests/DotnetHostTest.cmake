cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../DotnetHost.cmake")
if(NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "TEST_ROOT is required")
endif()
set(root "${TEST_ROOT}/dotnet-host-fixture")
file(REMOVE_RECURSE "${root}")
foreach(pair IN ITEMS "linux-x64/10.0.9" "linux-x64/10.0.15" "fedora.43-x64/10.0.13"
        "linux-x64/9.0.21" "linux-arm64/10.0.15")
    string(REPLACE "/" ";" parts "${pair}")
    list(GET parts 0 rid)
    list(GET parts 1 version)
    file(MAKE_DIRECTORY "${root}/packs/Microsoft.NETCore.App.Host.${rid}/${version}/runtimes/${rid}/native")
endforeach()
lux_dotnet_host_candidates(paths "${root}" linux-x64 fedora.43-x64)
set(expected
    "${root}/packs/Microsoft.NETCore.App.Host.linux-x64/10.0.15/runtimes/linux-x64/native"
    "${root}/packs/Microsoft.NETCore.App.Host.linux-x64/10.0.9/runtimes/linux-x64/native"
    "${root}/packs/Microsoft.NETCore.App.Host.fedora.43-x64/10.0.13/runtimes/fedora.43-x64/native")
if(NOT paths STREQUAL expected)
    message(FATAL_ERROR "Unexpected .NET host candidates: ${paths}")
endif()
lux_dotnet_host_candidates(paths "${root}" fedora.43-x64)
list(LENGTH paths count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Distribution SDK host pack was not found")
endif()
lux_dotnet_host_candidates(paths "${root}" osx-x64 "../invalid")
if(paths)
    message(FATAL_ERROR "Unrelated platform or invalid RID was selected")
endif()
file(REMOVE_RECURSE "${root}")
message(STATUS ".NET host discovery regression checks passed")
