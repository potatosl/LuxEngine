@PACKAGE_INIT@
set(LuxEngine_SHADER_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/shaders")

include(CMakeFindDependencyMacro)
# The hints point at the packages the engine was built with, so games find them even without the
# same CMAKE_PREFIX_PATH or vcpkg toolchain.
find_dependency(SDL3 3.2 CONFIG HINTS "@SDL3_DIR@")
find_dependency(box2d 2.4...<3 CONFIG HINTS "@box2d_DIR@")
if(TARGET box2d::box2d)
    set_target_properties(box2d::box2d PROPERTIES
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "Release;Debug"
        MAP_IMPORTED_CONFIG_MINSIZEREL "Release;Debug"
    )
endif()
find_dependency(Vulkan 1.1)
include("${CMAKE_CURRENT_LIST_DIR}/LuxEngineTargets.cmake")

# Map configurations for multi-config generators (Visual Studio, Xcode)
# when only Debug (or only Release) libraries were installed.
foreach(_lux_target LuxEngine::Engine LuxEngine::Runtime)
    if(TARGET ${_lux_target})
        set_target_properties(${_lux_target} PROPERTIES
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO "Release;Debug"
            MAP_IMPORTED_CONFIG_MINSIZEREL "Release;Debug"
            MAP_IMPORTED_CONFIG_RELEASE "Release;Debug"
            MAP_IMPORTED_CONFIG_DEBUG "Debug;Release"
        )
    endif()
endforeach()
if(TARGET box2d::box2d)
    set_target_properties(box2d::box2d PROPERTIES
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "Release;Debug"
        MAP_IMPORTED_CONFIG_MINSIZEREL "Release;Debug"
        MAP_IMPORTED_CONFIG_RELEASE "Release;Debug"
        MAP_IMPORTED_CONFIG_DEBUG "Debug;Release"
    )
endif()

function(lux_copy_shaders target)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_directory
            "${LuxEngine_SHADER_DIR}"
            "$<TARGET_FILE_DIR:${target}>/shaders"
    )
endfunction()

check_required_components(LuxEngine)
