@PACKAGE_INIT@
set(LuxEngine_RUNTIME_DIR "${PACKAGE_PREFIX_DIR}/bin")
set(LuxEngine_RENDERER_DATA_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/renderer")
set(LuxEngine_MANAGED_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/managed")
set(LuxEngine_SHADER_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/shaders")
set(LuxEngine_TEMPLATES_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/templates")
set(LuxEngine_LICENSES_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/licenses")
set(LuxEngine_EXAMPLES_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/examples")
set(LuxEngine_MODELS_DIR "${PACKAGE_PREFIX_DIR}/share/LuxEngine/models")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
# The hints point at the packages the engine was built with, as well as the SDK prefix directory,
# so games find them even when relocated or without the same CMAKE_PREFIX_PATH or vcpkg toolchain.
find_dependency(SDL3 3.2 CONFIG HINTS
    "@SDL3_DIR@"
    "${PACKAGE_PREFIX_DIR}"
    "${PACKAGE_PREFIX_DIR}/lib/cmake/SDL3"
    "${PACKAGE_PREFIX_DIR}/share/sdl3"
)
find_dependency(box2d 2.4...<3 CONFIG HINTS
    "@box2d_DIR@"
    "${PACKAGE_PREFIX_DIR}"
    "${PACKAGE_PREFIX_DIR}/lib/cmake/box2d"
)
if(TARGET box2d::box2d)
    set_target_properties(box2d::box2d PROPERTIES
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "RelWithDebInfo;Release;Debug;NOCONFIG;"
        MAP_IMPORTED_CONFIG_MINSIZEREL "MinSizeRel;Release;Debug;NOCONFIG;"
        MAP_IMPORTED_CONFIG_RELEASE "Release;RelWithDebInfo;Debug;NOCONFIG;"
        MAP_IMPORTED_CONFIG_DEBUG "Debug;Release;RelWithDebInfo;NOCONFIG;"
    )
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LuxEngineTargets.cmake")

# Map configurations for multi-config generators (Visual Studio, Xcode)
# when only Debug (or only Release) libraries were installed.
foreach(_lux_target LuxEngine::Engine LuxEngine::Runtime)
    if(TARGET ${_lux_target})
        set_target_properties(${_lux_target} PROPERTIES
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO "RelWithDebInfo;Release;Debug;NOCONFIG;"
            MAP_IMPORTED_CONFIG_MINSIZEREL "MinSizeRel;Release;Debug;NOCONFIG;"
            MAP_IMPORTED_CONFIG_RELEASE "Release;RelWithDebInfo;Debug;NOCONFIG;"
            MAP_IMPORTED_CONFIG_DEBUG "Debug;Release;RelWithDebInfo;NOCONFIG;"
        )
    endif()
endforeach()
if(TARGET box2d::box2d)
    set_target_properties(box2d::box2d PROPERTIES
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "RelWithDebInfo;Release;Debug;NOCONFIG;"
        MAP_IMPORTED_CONFIG_MINSIZEREL "MinSizeRel;Release;Debug;NOCONFIG;"
        MAP_IMPORTED_CONFIG_RELEASE "Release;RelWithDebInfo;Debug;NOCONFIG;"
        MAP_IMPORTED_CONFIG_DEBUG "Debug;Release;RelWithDebInfo;NOCONFIG;"
    )
endif()

function(lux_copy_shaders target)
    if(EXISTS "${LuxEngine_SHADER_DIR}")
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_directory "${LuxEngine_SHADER_DIR}" "$<TARGET_FILE_DIR:${target}>")
    endif()
endfunction()

function(lux_copy_runtime target)
    lux_copy_shaders(${target})
    if(EXISTS "${LuxEngine_MODELS_DIR}")
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_directory "${LuxEngine_MODELS_DIR}"
                "$<TARGET_FILE_DIR:${target}>/Resources/Models"
            VERBATIM)
    endif()
    if(WIN32)
        set(_lux_nethost "nethost.dll")
    elseif(APPLE)
        set(_lux_nethost "libnethost.dylib")
    else()
        set(_lux_nethost "libnethost.so")
    endif()
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${LuxEngine_MANAGED_DIR}" "$<TARGET_FILE_DIR:${target}>/managed"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${LuxEngine_RUNTIME_DIR}/${_lux_nethost}" "$<TARGET_FILE_DIR:${target}>")
    if(WIN32)
        set(_lux_renderer_name "LuxForge.dll")
    elseif(APPLE)
        set(_lux_renderer_name "libLuxForge.dylib")
    else()
        set(_lux_renderer_name "libLuxForge.so")
    endif()
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${LuxEngine_RUNTIME_DIR}/${_lux_renderer_name}" "$<TARGET_FILE_DIR:${target}>"
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${LuxEngine_RENDERER_DATA_DIR}" "$<TARGET_FILE_DIR:${target}>")
    if(WIN32)
        foreach(_lux_renderer_dependency amd_ags_x64.dll dxcompiler.dll WinPixEventRuntime.dll dxil.dll)
            if(EXISTS "${LuxEngine_RUNTIME_DIR}/${_lux_renderer_dependency}")
                add_custom_command(TARGET ${target} POST_BUILD
                    COMMAND ${CMAKE_COMMAND} -E copy_if_different
                        "${LuxEngine_RUNTIME_DIR}/${_lux_renderer_dependency}" "$<TARGET_FILE_DIR:${target}>"
                    VERBATIM)
            endif()
        endforeach()
    endif()
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/project.luxproject" OR
       EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/project.luxproj")
        file(GLOB_RECURSE _lux_mesh_files CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[oO][bB][jJ]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[fF][bB][xX]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[lL][uU][xX][pP][rR][eE][fF][aA][bB]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[pP][nN][gG]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[jJ][pP][gG]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[jJ][pP][eE][gG]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[bB][mM][pP]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[tT][gG][aA]"
            "${CMAKE_CURRENT_SOURCE_DIR}/*.[hH][dD][rR]")
        add_custom_target(${target}_LuxMeshContent)
        foreach(_mesh IN LISTS _lux_mesh_files)
            if(_mesh MATCHES "(^|/)(\\.git|\\.lux)(/|$)" OR
               _mesh MATCHES "^(build|out|cmake-build[^/]*)(/|$)")
                continue()
            endif()
            get_filename_component(_mesh_directory "${_mesh}" DIRECTORY)
            add_custom_command(TARGET ${target}_LuxMeshContent POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E make_directory
                    "$<TARGET_FILE_DIR:${target}>/Content/${_mesh_directory}"
                COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    "${CMAKE_CURRENT_SOURCE_DIR}/${_mesh}"
                    "$<TARGET_FILE_DIR:${target}>/Content/${_mesh}"
                VERBATIM)
        endforeach()
        add_dependencies(${target} ${target}_LuxMeshContent)
    endif()
    if(WIN32)
        if(TARGET SDL3::SDL3-shared)
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    $<TARGET_FILE:SDL3::SDL3-shared>
                    "$<TARGET_FILE_DIR:${target}>"
            )
        elseif(EXISTS "${LuxEngine_RUNTIME_DIR}/SDL3.dll")
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different
                    "${LuxEngine_RUNTIME_DIR}/SDL3.dll"
                    "$<TARGET_FILE_DIR:${target}>"
            )
        endif()
        if(TARGET box2d::box2d)
            get_target_property(_box2d_type box2d::box2d TYPE)
            if(_box2d_type STREQUAL "SHARED_LIBRARY")
                add_custom_command(TARGET ${target} POST_BUILD
                    COMMAND ${CMAKE_COMMAND} -E copy_if_different
                        $<TARGET_FILE:box2d::box2d>
                        "$<TARGET_FILE_DIR:${target}>"
                )
            endif()
        endif()
        if(TARGET LuxEngine::Engine)
            get_target_property(_lux_type LuxEngine::Engine TYPE)
            if(_lux_type STREQUAL "SHARED_LIBRARY")
                add_custom_command(TARGET ${target} POST_BUILD
                    COMMAND ${CMAKE_COMMAND} -E copy_if_different
                        $<TARGET_FILE:LuxEngine::Engine>
                        "$<TARGET_FILE_DIR:${target}>"
                )
            endif()
        endif()
        if(EXISTS "${LuxEngine_LICENSES_DIR}")
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_directory
                    "${LuxEngine_LICENSES_DIR}"
                    "$<TARGET_FILE_DIR:${target}>/licenses"
            )
        endif()
    endif()
endfunction()

check_required_components(LuxEngine)
