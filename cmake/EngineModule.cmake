# Internal object targets enforce module compilation boundaries. The SDK exports only LuxEngine.
function(lux_engine_module name)
    cmake_parse_arguments(MODULE "HEADER_ONLY" "" "PUBLIC_DEPENDENCIES;PRIVATE_DEPENDENCIES;SOURCES;HEADERS" ${ARGN})
    set(target LuxModule${name})
    if(MODULE_HEADER_ONLY)
        add_library(${target} INTERFACE)
        target_include_directories(${target} INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/Public")
        target_link_libraries(${target} INTERFACE ${MODULE_PUBLIC_DEPENDENCIES})
    else()
        add_library(${target} OBJECT ${MODULE_SOURCES} ${MODULE_HEADERS})
        set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
        target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/Public"
            PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/Private")
        target_link_libraries(${target} PUBLIC ${MODULE_PUBLIC_DEPENDENCIES}
            PRIVATE ${MODULE_PRIVATE_DEPENDENCIES})
        if(LUX_BUILD_SHARED)
            target_compile_definitions(${target} PUBLIC LUX_ENGINE_SHARED PRIVATE LUX_ENGINE_BUILD)
        endif()
        if(LUX_GPU_FAULT_INJECTION)
            target_compile_definitions(${target} PRIVATE LUX_GPU_FAULT_INJECTION=1)
        endif()
        lux_set_target_warnings(${target})
        source_group(TREE "${CMAKE_CURRENT_SOURCE_DIR}" FILES ${MODULE_SOURCES} ${MODULE_HEADERS})
        target_sources(LuxEngine PRIVATE $<TARGET_OBJECTS:${target}>)
    endif()
    target_include_directories(LuxEngine PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Public>)
    install(DIRECTORY Public/ DESTINATION include FILES_MATCHING PATTERN "*.hpp" PATTERN "*.inl")
endfunction()
