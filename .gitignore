# Visual Studio & IDEs
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.vscode/
.idea/

# CMake & Build Artifacts
# Only the top-level build folder: Windows matches ignore rules case-insensitively, and a bare
# "build/" also hid the editor's source folder Editor/Build/.
/build/
/dist/
bin/
out/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
compile_commands.json
*.dir/

# Compiled Binaries & Libraries
*.obj
!/Engine/Resources/Characters/**/*.obj
!/samples/MeshFoundation/Assets/*.obj
*.o
*.lib
*.a
*.exp
*.dll
*.so
*.dylib
*.exe
*.pdb
*.ilk

# Dependency downloads
_deps/
subprojects/

# OS Specific
Thumbs.db
[Dd]esktop.ini
.DS_Store

tools/dxc/
# Mumu: the zip bundles the folder and previews are regenerated by tools/BuildMumu.py
/Engine/Resources/Characters/Mumu.zip
/Engine/Resources/Characters/Mumu/previews/

/external/
